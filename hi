#include <iostream>
using namespace std;
class Area
{
   public:
      void area(float l, float b)
      {
          cout << "area of rectangle ="<< l*b << endl;
      }
};

class Perimeter
{
    public:
        void perimeter(float l, float b )     
        {
            cout << "perimeter of rectangle="<< 2*(l+b) << endl;
        }
};

class Rectangle : public Area, public Perimeter
{
    protected:
         float length, breadth;
    public:
          void get_data()
          {
             cout << " enter length and breadth=" << endl;
             cin >> length >> breadth;
          }
          void display()
          {
             area(length,breadth);
             perimeter(length,breadth);
          }
};
 
 int main()
 {
   Rectangle r;
   r. get_data();
   r. display();
 }